# Port du serveur
PORT=5000
# development ou production (en production, le serveur sert aussi client/dist)
NODE_ENV=development
# Origines autorisées pour l'API, séparées par des virgules
CLIENT_ORIGIN=http://localhost:5173
# true si le serveur est derrière un proxy (Render, Railway, Fly...)
TRUST_PROXY=false

# Destinataire des notifications internes de préinscription
NOTIFY_EMAIL=
# SMTP (Gmail : mot de passe d'application, jamais le mot de passe du compte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Sheets via Apps Script (voir tools/inscriptions/Code.gs)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
